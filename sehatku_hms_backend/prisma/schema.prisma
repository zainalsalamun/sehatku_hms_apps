// ==============================================================================
// Prisma Schema for SehatKu Hospital Management System
// Target Database: PostgreSQL 15/16
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hospital {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  timezone    String   @default("Asia/Jakarta")
  address     String?
  phone       String?
  email       String?
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  version     Int      @default(1)

  departments  Department[]
  doctors      Doctor[]
  patients     Patient[]
  appointments Appointment[]
  userRoles    UserRole[]
  invoices     Invoice[]
  auditLogs    AuditLog[]
  procedures   Procedure[]
  medicalCertificates MedicalCertificate[]
  cashierShifts CashierShift[]
  roomBeds      RoomBed[]
  inpatientAdmissions InpatientAdmission[]
  labTestCatalogs LabTestCatalog[]
  labOrders     LabOrder[]

  @@map("hospitals")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String?
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  status       String    @default("active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  version      Int       @default(1)

  userRoles     UserRole[]
  doctors       Doctor[]
  patients      Patient[]
  notifications Notification[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  roleId     String    @map("role_id")
  hospitalId String?   @map("hospital_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, hospitalId])
  @@map("user_roles")
}

model Department {
  id          String   @id @default(uuid())
  hospitalId  String   @map("hospital_id")
  code        String
  name        String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  version     Int      @default(1)

  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  doctors     Doctor[]

  @@unique([hospitalId, code])
  @@map("departments")
}

model Doctor {
  id              String    @id @default(uuid())
  userId          String?   @map("user_id")
  hospitalId      String    @map("hospital_id")
  departmentId    String    @map("department_id")
  licenseNumber   String    @map("license_number")
  name            String
  specialist      String
  biography       String?
  experienceYears Int       @default(0) @map("experience_years")
  rating          Decimal   @default(5.00) @db.Decimal(3, 2)
  availableToday  Boolean   @default(true) @map("available_today")
  status          String    @default("active")
  phone           String?
  email           String?
  scheduleDays    String[]  @default(["Senin", "Rabu", "Jumat"]) @map("schedule_days")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  version         Int       @default(1)

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  hospital        Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  schedules       DoctorSchedule[]
  appointments    Appointment[]
  encounters      Encounter[]
  prescriptions   Prescription[]
  medicalCertificates MedicalCertificate[]
  inpatientAdmissions InpatientAdmission[]
  labOrders           LabOrder[]

  @@unique([hospitalId, licenseNumber])
  @@map("doctors")
}

model DoctorSchedule {
  id          String   @id @default(uuid())
  doctorId    String   @map("doctor_id")
  dayOfWeek   String   @map("day_of_week")
  startTime   String   @map("start_time")
  endTime     String   @map("end_time")
  slotMinutes Int      @default(30) @map("slot_minutes")
  maxPatients Int      @default(20) @map("max_patients")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  version     Int      @default(1)

  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("doctor_schedules")
}

model Patient {
  id                  String   @id @default(uuid())
  userId              String?  @map("user_id")
  hospitalId          String   @map("hospital_id")
  medicalRecordNumber String   @map("medical_record_number")
  nik                 String?
  name                String
  birthDate           DateTime @map("birth_date") @db.Date
  gender              String
  bloodType           String?  @map("blood_type")
  insuranceProvider   String?  @map("insurance_provider")
  insuranceNumber     String?  @map("insurance_number")
  phone               String?
  email               String?
  address             String?
  emergencyContact    String?  @map("emergency_contact")
  status              String   @default("Aktif")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")
  version             Int      @default(1)

  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  hospital            Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  appointments        Appointment[]
  encounters          Encounter[]
  prescriptions       Prescription[]
  invoices            Invoice[]
  medicalCertificates MedicalCertificate[]
  inpatientAdmissions InpatientAdmission[]
  labOrders           LabOrder[]

  @@unique([hospitalId, medicalRecordNumber])
  @@map("patients")
}

model Appointment {
  id                 String   @id @default(uuid())
  hospitalId         String   @map("hospital_id")
  doctorId           String   @map("doctor_id")
  patientId          String   @map("patient_id")
  dateLabel          String   @map("date_label")
  appointmentDate    DateTime @default(now()) @map("appointment_date") @db.Date
  appointmentTime    String   @map("appointment_time")
  queueNumber        String   @map("queue_number")
  departmentName     String   @map("department_name")
  reason             String?
  cancellationReason String?  @map("cancellation_reason")
  status             String   @default("Menunggu")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")
  version            Int      @default(1)

  hospital           Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  doctor             Doctor       @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patient            Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  queueTicket        QueueTicket?
  encounters         Encounter[]
  invoices           Invoice[]

  @@map("appointments")
}

model QueueTicket {
  id            String    @id @default(uuid())
  appointmentId String    @unique @map("appointment_id")
  serviceDate   DateTime  @default(now()) @map("service_date") @db.Date
  prefix        String
  sequence      Int
  queueNumber   String    @map("queue_number")
  status        String    @default("waiting")
  calledAt      DateTime? @map("called_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  version       Int       @default(1)

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("queue_tickets")
}

model Encounter {
  id               String    @id @default(uuid())
  appointmentId    String?   @map("appointment_id")
  patientId        String    @map("patient_id")
  doctorId         String    @map("doctor_id")
  startedAt        DateTime  @default(now()) @map("started_at")
  endedAt          DateTime? @map("ended_at")
  anamnesis        String?
  physicalExam     String?   @map("physical_exam")
  diagnosisSummary String?   @map("diagnosis_summary")
  status           String    @default("draft")
  signedAt         DateTime? @map("signed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  version          Int       @default(1)

  appointment      Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patient          Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor           Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  diagnoses        Diagnosis[]
  prescriptions    Prescription[]
  procedures       EncounterProcedure[]
  medicalCertificate MedicalCertificate?

  @@map("encounters")
}

model Diagnosis {
  id          String   @id @default(uuid())
  encounterId String   @map("encounter_id")
  icd10Code   String?  @map("icd10_code")
  description String
  type        String   @default("primary")
  createdAt   DateTime @default(now()) @map("created_at")

  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@map("diagnoses")
}

model Prescription {
  id          String   @id @default(uuid())
  encounterId String   @map("encounter_id")
  patientId   String   @map("patient_id")
  doctorId    String   @map("doctor_id")
  notes       String?
  status      String   @default("issued")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  encounter   Encounter          @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patient     Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor      Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  items       PrescriptionItem[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String   @id @default(uuid())
  prescriptionId String   @map("prescription_id")
  medicineName   String   @map("medicine_name")
  dosage         String
  frequency      String
  route          String   @default("oral")
  durationDays   Int      @default(3) @map("duration_days")
  instruction    String?
  createdAt      DateTime @default(now()) @map("created_at")

  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique @map("invoice_number")
  hospitalId    String    @map("hospital_id")
  appointmentId String?   @map("appointment_id")
  patientId     String    @map("patient_id")
  patientName   String    @map("patient_name")
  doctorName    String    @map("doctor_name")
  serviceName   String    @map("service_name")
  amount        Decimal   @default(0.00) @db.Decimal(12, 2)
  status        String    @default("Menunggu")
  paymentMethod String    @default("Tunai") @map("payment_method")
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  version       Int       @default(1)

  hospital      Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@map("invoices")
}

model AuditLog {
  id           String    @id @default(uuid())
  hospitalId   String?   @map("hospital_id")
  actorId      String?   @map("actor_id")
  actorName    String    @map("actor_name")
  actorRole    String    @map("actor_role")
  action       String
  resourceType String    @map("resource_type")
  resourceId   String    @map("resource_id")
  details      String
  ipAddress    String    @default("127.0.0.1") @map("ip_address")
  userAgent    String?   @map("user_agent")
  timestamp    DateTime  @default(now())

  hospital     Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  role      String   @default("all") // 'patient', 'doctor', 'admin', 'all'
  title     String
  message   String
  type      String   @default("info") // 'appointment', 'prescription', 'billing', 'clinical', 'system', 'emergency'
  isRead    Boolean  @default(false) @map("is_read")
  targetId  String?  @map("target_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model Procedure {
  id          String   @id @default(uuid())
  hospitalId  String   @map("hospital_id")
  code        String   @unique
  name        String
  category    String   @default("Umum") // 'Umum', 'Gigi', 'Tindakan Medis', 'Laboratorium Rapid', 'Keperawatan'
  description String?
  price       Decimal  @default(0.00) @db.Decimal(12, 2)
  status      String   @default("active") // 'active', 'inactive'
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  hospital    Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  encounters  EncounterProcedure[]

  @@map("procedures")
}

model EncounterProcedure {
  id          String   @id @default(uuid())
  encounterId String   @map("encounter_id")
  procedureId String   @map("procedure_id")
  name        String
  price       Decimal  @default(0.00) @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Restrict)

  @@map("encounter_procedures")
}

model MedicalCertificate {
  id                String    @id @default(uuid())
  certificateNumber String    @unique @map("certificate_number")
  type              String    @default("sick_leave") // 'sick_leave' (Surat Keterangan Sakit / SKD), 'healthy' (Surat Keterangan Sehat)
  hospitalId        String    @map("hospital_id")
  encounterId       String?   @unique @map("encounter_id")
  patientId         String    @map("patient_id")
  doctorId          String    @map("doctor_id")
  diagnosis         String?
  startDate         DateTime  @default(now()) @map("start_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  durationDays      Int       @default(1) @map("duration_days")
  notes             String?
  status            String    @default("issued")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  hospital          Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  encounter         Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  patient           Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor            Doctor     @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@map("medical_certificates")
}

model CashierShift {
  id                    String    @id @default(uuid())
  hospitalId            String    @map("hospital_id")
  cashierId             String    @map("cashier_id")
  cashierName           String    @map("cashier_name")
  shiftName             String    @default("Pagi") @map("shift_name") // 'Pagi', 'Siang', 'Malam'
  startTime             DateTime  @default(now()) @map("start_time")
  endTime               DateTime? @map("end_time")
  initialCash           Decimal   @default(0.00) @map("initial_cash") @db.Decimal(12, 2)
  totalCashReceived     Decimal   @default(0.00) @map("total_cash_received") @db.Decimal(12, 2)
  totalQrisReceived     Decimal   @default(0.00) @map("total_qris_received") @db.Decimal(12, 2)
  totalTransferReceived Decimal   @default(0.00) @map("total_transfer_received") @db.Decimal(12, 2)
  totalDebitReceived    Decimal   @default(0.00) @map("total_debit_received") @db.Decimal(12, 2)
  totalCardReceived     Decimal   @default(0.00) @map("total_card_received") @db.Decimal(12, 2)
  totalTransactions     Int       @default(0) @map("total_transactions")
  expectedCashEnd       Decimal   @default(0.00) @map("expected_cash_end") @db.Decimal(12, 2)
  actualCashCounted     Decimal?  @map("actual_cash_counted") @db.Decimal(12, 2)
  discrepancy           Decimal?  @db.Decimal(12, 2)
  status                String    @default("OPEN") // 'OPEN', 'CLOSED'
  notes                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  hospital              Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  @@map("cashier_shifts")
}

model RoomBed {
  id         String   @id @default(uuid())
  hospitalId String   @map("hospital_id")
  roomNumber String   @map("room_number")
  roomName   String   @map("room_name")
  bedNumber  String   @map("bed_number")
  classType  String   @default("Kelas 1") @map("class_type")
  dailyRate  Decimal  @default(250000.00) @map("daily_rate") @db.Decimal(12, 2)
  status     String   @default("available") // 'available', 'occupied', 'cleaning', 'maintenance'
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  hospital   Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  admissions InpatientAdmission[]

  @@map("room_beds")
}

model InpatientAdmission {
  id                 String    @id @default(uuid())
  admissionNumber    String    @unique @map("admission_number")
  hospitalId         String    @map("hospital_id")
  patientId          String    @map("patient_id")
  doctorId           String    @map("doctor_id")
  bedId              String    @map("bed_id")
  admissionDate      DateTime  @default(now()) @map("admission_date")
  dischargeDate      DateTime? @map("discharge_date")
  admissionType      String    @default("Poliklinik") @map("admission_type")
  initialDiagnosis   String?   @map("initial_diagnosis")
  dischargeDiagnosis String?   @map("discharge_diagnosis")
  dischargeCondition String?   @map("discharge_condition")
  status             String    @default("active") // 'active', 'discharged', 'transferred', 'cancelled'
  totalDays          Int       @default(1) @map("total_days")
  totalBedCost       Decimal   @default(0.00) @map("total_bed_cost") @db.Decimal(12, 2)
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  hospital           Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient            Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor             Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  bed                RoomBed        @relation(fields: [bedId], references: [id], onDelete: Restrict)
  cpptRecords        InpatientCPPT[]

  @@map("inpatient_admissions")
}

model InpatientCPPT {
  id               String   @id @default(uuid())
  admissionId      String   @map("admission_id")
  recorderRole     String   @default("Dokter DPJP") @map("recorder_role")
  recorderName     String   @map("recorder_name")
  recordedAt       DateTime @default(now()) @map("recorded_at")
  subjective       String?
  objective        String?
  assessment       String?
  plan             String?
  instruction      String?
  bloodPressure    String?  @map("blood_pressure")
  heartRate        Int?     @map("heart_rate")
  temperature      Decimal? @db.Decimal(4, 1)
  respiratoryRate  Int?     @map("respiratory_rate")
  oxygenSaturation Int?     @map("oxygen_saturation")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  admission        InpatientAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@map("inpatient_cppt")
}

model LabTestCatalog {
  id              String   @id @default(uuid())
  hospitalId      String   @map("hospital_id")
  code            String
  name            String
  category        String   // 'Hematologi', 'Kimia Klinik', 'Urinalisis', 'Imunologi & Serologi', 'Radiologi', 'Mikrobiologi'
  sampleType      String   @default("Darah Vena") @map("sample_type")
  unit            String?
  normalRangeMin  Decimal? @map("normal_range_min") @db.Decimal(10, 2)
  normalRangeMax  Decimal? @map("normal_range_max") @db.Decimal(10, 2)
  normalRangeText String?  @map("normal_range_text")
  price           Decimal  @default(0.00) @db.Decimal(12, 2)
  description     String?
  status          String   @default("active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  hospital        Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  orderItems      LabOrderItem[]

  @@unique([hospitalId, code])
  @@map("lab_test_catalogs")
}

model LabOrder {
  id                  String    @id @default(uuid())
  orderNumber         String    @unique @map("order_number")
  hospitalId          String    @map("hospital_id")
  patientId           String    @map("patient_id")
  doctorId            String    @map("doctor_id")
  appointmentId       String?   @map("appointment_id")
  admissionId         String?   @map("admission_id")
  priority            String    @default("Normal") // 'Normal', 'CITO'
  clinicalDiagnosis   String?   @map("clinical_diagnosis")
  clinicalNotes       String?   @map("clinical_notes")
  status              String    @default("ordered") // 'ordered', 'sample_collected', 'in_progress', 'completed', 'cancelled'
  sampleCollectedAt   DateTime? @map("sample_collected_at")
  sampleCollectorName String?   @map("sample_collector_name")
  completedAt         DateTime? @map("completed_at")
  verifiedBy          String?   @map("verified_by")
  totalCost           Decimal   @default(0.00) @map("total_cost") @db.Decimal(12, 2)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  hospital            Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient             Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor              Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  items               LabOrderItem[]

  @@map("lab_orders")
}

model LabOrderItem {
  id              String    @id @default(uuid())
  labOrderId      String    @map("lab_order_id")
  testCatalogId   String?   @map("test_catalog_id")
  testCode        String    @map("test_code")
  testName        String    @map("test_name")
  category        String
  price           Decimal   @default(0.00) @db.Decimal(12, 2)
  resultValue     String?   @map("result_value")
  unit            String?
  normalRangeText String?   @map("normal_range_text")
  flag            String?   // 'normal', 'low', 'high', 'critical'
  status          String    @default("pending") // 'pending', 'in_progress', 'completed'
  analystNotes    String?   @map("analyst_notes")
  analyzedAt      DateTime? @map("analyzed_at")
  analyzedBy      String?   @map("analyzed_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  labOrder        LabOrder        @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  testCatalog     LabTestCatalog? @relation(fields: [testCatalogId], references: [id], onDelete: SetNull)

  @@map("lab_order_items")
}




